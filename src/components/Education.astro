---
import { education } from '../data/resume';
import OrganizationMark from './OrganizationMark.astro';
---

<div class="education-entry">
  <div class="resume-heading">
    <h3><a href="https://www.berkeley.edu/"><OrganizationMark name="UC Berkeley" />{education.school}</a></h3>
    <span class="entry-date">{education.dates}</span>
  </div>
  <p>{education.degree}</p>
  <p class="education-activities">{education.activities}</p>
</div>
